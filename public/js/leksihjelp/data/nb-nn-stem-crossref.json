  "utelatne": {
    "beliggen": {
      "grunn": "Ikkje oppslagsord i Bokmålsordboka — det bokmålske adjektivet er `beliggende`. `beliggenhet` svarar til `plassering`, eit anna ord utan felles stamme, så det finst inga stammeform å føre. Dekt på ordnivå i _shared/cross-standard-nb-nn.json.",
      "kjelde": "Bokmålsordboka + Språkrådets administrative ordliste (`beliggenhet plassering, stad(val)`)",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "utlendig": {
      "grunn": "Bokmålsordboka fører adjektivet, men nynorsk har inga stammeform for det — `landflyktig` og `utanlandsk` er andre ord. Substantivet går `utlendighet → utlendingskap`, avleidd av substantivet `utlending`, ikkje av eit adjektiv. Krev ein heilordsregel.",
      "kjelde": "ordbokene.no (inga omsetjing av adjektivet) + Språkrådets administrative ordliste (ikkje ført)",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "klassebevisst": {
      "grunn": "Samansetjing av `klasse` + `bevisst`, og begge ledda er gyldig nynorsk (`bevisst` er artikkel 5713 i Nynorskordboka og står i Norsk ordbank). Samansetjinga er difor formbar på nynorsk, og inga kjelde seier ho er feil. Ei oppføring på `klassemedviten` ville retta gyldig nynorsk mot ei sjeldnare form (korpus etter 2012: klassebevisst 25, klassemedviten 3) — feilklassen kriterium 3 vernar mot. Generaliseringa høyrer på etterleddet, og `bevisst` er ikkje ein bokmålisme.",
      "kjelde": "Nynorskordboka + Norsk ordbank + NB n-gram (lang=nno); Språkrådets ordliste teier",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "pengegrisk": {
      "grunn": "Samansetjing av `penge` + `grisk`, og `grisk` er gyldig nynorsk. Samansetjinga er formbar på nynorsk, altså ingen bokmålisme. Same tilfellet som `klassebevisst`. Ikkje oppslagsord i Bokmålsordboka heller.",
      "kjelde": "Nynorskordboka + Norsk ordbank; ordbokene.no har inga omsetjing",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "kulturbevisst": {
      "grunn": "Samansetjing av `kultur` + `bevisst`, og `bevisst` er gyldig nynorsk (artikkel 5713). Formbar på nynorsk. Same tilfellet som `klassebevisst`. Ikkje oppslagsord i Bokmålsordboka.",
      "kjelde": "Nynorskordboka + Norsk ordbank; ordbokene.no har inga omsetjing",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "kontrollerbar": {
      "grunn": "Ikkje oppslagsord i Bokmålsordboka. `kontrollere` + `-bar` er ei produktiv avleiing som er like nynorsk som bokmålsk — inkje ledd er bokmålsspesifikt. At Norsk ordbank ikkje fører henne, seier berre at lista ikkje tek med alle -bar-avleiingar.",
      "kjelde": "Bokmålsordboka + Norsk ordbank; ordbokene.no har inga omsetjing",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "grusom": {
      "grunn": "`grusam` finst ikkje på nynorsk. ordbokene.no gjev tre urangerte synonym (`grufull`, `frykteleg`, `forferdeleg`) som alle er andre ord, og substantivet går til `råskap`. Det finst inga nynorsk STAMME å føre, og å velje eitt av synonyma ville vere eit leksikalsk val ingen kjelde støttar.",
      "kjelde": "Nynorskordboka (`grusam` ikkje ført) + ordbokene.no (`grusomhet → råskap`)",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "anspent": {
      "grunn": "ordbokene.no har inga omsetjing, verken av adjektivet eller av `anspenthet`, og inga nynorsk form er registrert i Nynorskordboka eller Norsk ordbank. Ingen kjelde å føre etter.",
      "kjelde": "ordbokene.no + Nynorskordboka + Norsk ordbank — alle tause",
      "godkjent_av": "Geir, 2026-08-26"
    },
    "beskaffen": {
